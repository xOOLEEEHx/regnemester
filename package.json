{
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck:regnereisen && vite build",
    "perf:inventory": "node scripts/performance/inventory-build.mjs",
    "perf:capture": "node scripts/performance/collect-baseline.mjs",
    "perf:cleanup": "node scripts/performance/validate-cleanup.mjs",
    "perf:report": "node scripts/performance/analyze-baseline.mjs --write-report",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "typecheck:regnereisen": "tsc -p tsconfig.regnereisen.json"
  },
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.111.0",
    "@vercel/speed-insights": "2.0.0",
    "lucide-react": "1.24.0",
    "page-flip": "^2.0.7",
    "phaser": "4.2.1",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.0.3",
    "playwright": "1.62.1",
    "typescript": "^5.8.3",
    "vite": "8.1.4"
  }
}
